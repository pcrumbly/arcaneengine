{
  "name": "EntityTag",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "world_instance_id": {
      "type": "string"
    },
    "target_type": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "target_ref": {
      "type": "object",
      "additionalProperties": true
    },
    "tag": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "runtime",
        "permanent"
      ],
      "default": "runtime"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "taxonomy",
        "visible",
        "hidden"
      ],
      "default": "taxonomy"
    },
    "source_type": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "string",
      "enum": [
        "direct",
        "definition",
        "runtime",
        "inherited",
        "system"
      ],
      "default": "runtime"
    },
    "inheritance_mode": {
      "type": "string",
      "enum": [
        "none",
        "target",
        "descendants"
      ],
      "default": "none"
    },
    "inherited_from_ref": {
      "type": "object",
      "additionalProperties": true
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "target_type",
    "target_id",
    "tag",
    "scope",
    "visibility",
    "provenance",
    "inheritance_mode"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}