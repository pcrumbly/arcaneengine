{
  "name": "NPCMemory",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "world_instance_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "npc_instance_id": {
      "type": "string"
    },
    "subject_ref": {
      "type": "object",
      "additionalProperties": true
    },
    "memory_key": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "facts": {
      "type": "object",
      "additionalProperties": true
    },
    "salience": {
      "type": "number",
      "minimum": 0
    },
    "valence": {
      "type": "number"
    },
    "remembered_minute": {
      "type": "number",
      "minimum": 0
    },
    "decays_minute": {
      "type": "number",
      "minimum": 0
    },
    "source_event_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "faded",
        "suppressed"
      ],
      "default": "active"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "world_instance_id",
    "content_version",
    "npc_instance_id",
    "subject_ref",
    "memory_key",
    "summary",
    "salience",
    "remembered_minute",
    "status",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}