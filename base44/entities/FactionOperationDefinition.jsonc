{
  "name": "FactionOperationDefinition",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "faction_key": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number",
      "minimum": 1
    },
    "repeat_interval_minutes": {
      "type": "number",
      "minimum": 1
    },
    "conditions": {
      "type": "object",
      "additionalProperties": true
    },
    "state_changes": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "reputation_changes": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "rumor_definition_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "game_id",
    "content_version",
    "key",
    "name",
    "faction_key",
    "duration_minutes"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}