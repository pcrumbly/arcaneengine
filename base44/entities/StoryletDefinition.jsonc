{
  "name": "StoryletDefinition",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "event",
        "tick"
      ],
      "default": "event"
    },
    "event_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tick_interval_minutes": {
      "type": "number",
      "minimum": 1
    },
    "priority": {
      "type": "number",
      "default": 0
    },
    "conditions": {
      "type": "object",
      "additionalProperties": true
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "emitted_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "once_per_character": {
      "type": "boolean",
      "default": false
    },
    "cooldown_minutes": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "recap": {
      "type": "object",
      "additionalProperties": true
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "game_id",
    "content_version",
    "key",
    "name",
    "trigger_type",
    "enabled"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}