{
  "name": "FactionOperation",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "world_instance_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "definition_id": {
      "type": "string"
    },
    "definition_key": {
      "type": "string"
    },
    "faction_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "completed",
        "cancelled",
        "failed"
      ]
    },
    "started_minute": {
      "type": "number",
      "minimum": 0
    },
    "due_minute": {
      "type": "number",
      "minimum": 0
    },
    "completed_minute": {
      "type": "number",
      "minimum": 0
    },
    "occurrence_key": {
      "type": "string"
    },
    "result": {
      "type": "object",
      "additionalProperties": true
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "world_instance_id",
    "content_version",
    "definition_id",
    "definition_key",
    "faction_key",
    "status",
    "started_minute",
    "due_minute",
    "occurrence_key",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}