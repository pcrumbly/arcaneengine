      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "condition",
        "effect"
      ]
    },
    "namespace": {
      "type": "string"
    },
    "package_key": {
      "type": "string"
    },
    "api_version": {
      "type": "string",
      "default": "1"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "condition_template": {
      "type": "object",
      "additionalProperties": true
    },
    "effect_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "required": [
    "game_id",
    "content_version",
    "key",
    "name",
    "kind"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
