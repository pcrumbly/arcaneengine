{
  "name": "EncounterDefinition",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "location_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "turn_model": {
      "type": "string",
      "enum": [
        "individual_initiative",
        "side_based",
        "simultaneous"
      ],
      "default": "individual_initiative"
    },
    "ai_policy": {
      "type": "object",
      "properties": {
        "ability_selection": {
          "type": "string",
          "enum": [
            "first_available",
            "random_available",
            "highest_impact",
            "lowest_cost"
          ]
        },
        "target_selection": {
          "type": "string",
          "enum": [
            "first_active",
            "random_active",
            "lowest_primary_resource",
            "highest_primary_resource"
          ]
        }
      }
    },
    "participant_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "victory_conditions": {
      "type": "object",
      "additionalProperties": true
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "game_id",
    "content_version",
    "key",
    "name",
    "participant_templates"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}