{
  "name": "Formation",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "party_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "content_version",
    "party_id",
    "name",
    "slots"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}