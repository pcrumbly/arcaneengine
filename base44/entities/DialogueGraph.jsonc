{
  "name": "DialogueGraph",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "start_node_key": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "narration"
            ]
          },
          "text": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "nextNodeKey": {
                  "type": "string"
                },
                "conditions": {
                  "type": "object",
                  "additionalProperties": true
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "event_type": {
                        "type": "string"
                      },
                      "payload": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "required": [
                      "event_type"
                    ]
                  }
                },
                "skill_check": {
                  "type": "object",
                  "properties": {
                    "attribute_id": {
                      "type": "string"
                    },
                    "difficulty": {
                      "type": "number"
                    },
                    "die_sides": {
                      "type": "number",
                      "default": 20
                    },
                    "success_node_key": {
                      "type": "string"
                    },
                    "failure_node_key": {
                      "type": "string"
                    },
                    "success_effects": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "failure_effects": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "success_events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "failure_events": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  },
                  "required": [
                    "attribute_id",
                    "difficulty"
                  ]
                },
                "random_branch": {
                  "type": "object",
                  "properties": {
                    "outcomes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "weight": {
                            "type": "number"
                          },
                          "next_node_key": {
                            "type": "string"
                          },
                          "effects": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          },
                          "events": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          }
                        },
                        "required": [
                          "key",
                          "weight"
                        ]
                      }
                    }
                  },
                  "required": [
                    "outcomes"
                  ]
                }
              },
              "required": [
                "key",
                "label"
              ]
            }
          }
        },
        "required": [
          "key",
          "text"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "game_id",
    "content_version",
    "key",
    "name",
    "start_node_key",
    "nodes"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}