{
  "name": "NPCInstance",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "definition_id": {
      "type": "string"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "hidden",
        "departed"
      ],
      "default": "available"
    },
    "personal_state": {
      "type": "object",
      "additionalProperties": true
    },
    "public_state": {
      "type": "object",
      "additionalProperties": true
    },
    "inventory_container_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "content_version",
    "key",
    "definition_id",
    "availability"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}