{
  "name": "KeyBinding",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "command_id": {
      "type": "string"
    },
    "binding": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "user_id",
    "command_id",
    "binding",
    "category"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}