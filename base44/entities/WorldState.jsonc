{
  "name": "WorldState",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "current_time": {
      "type": "string",
      "format": "date-time"
    },
    "weather_by_region": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "weather_slot": {
      "type": "number",
      "default": 0
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "content_version",
    "current_time",
    "weather_by_region",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}