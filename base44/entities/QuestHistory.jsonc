      "type": "string"
    },
    "quest_instance_id": {
      "type": "string"
    },
    "quest_definition_id": {
      "type": "string"
    },
    "entry_type": {
      "type": "string"
    },
    "objective_key": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    },
    "source_event_id": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string"
    },
    "world_minute": {
      "type": "number",
      "minimum": 0
    },
