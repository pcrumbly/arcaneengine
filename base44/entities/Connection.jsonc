{
  "name": "Connection",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "from_location_id": {
      "type": "string"
    },
    "to_location_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "travel_time": {
      "type": "number",
      "default": 0
    },
    "resource_cost": {
      "type": "number",
      "default": 0
    },
    "one_way": {
      "type": "boolean",
      "default": false
    },
    "required_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": true
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "game_id",
    "content_version",
    "from_location_id",
    "to_location_id",
    "label"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}