{
  "name": "Character",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "current_location_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "in_combat",
        "inactive"
      ],
      "default": "active"
    },
    "is_test_character": {
      "type": "boolean",
      "default": false
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "currency": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "content_version",
    "name",
    "current_location_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}