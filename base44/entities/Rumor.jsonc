{
  "name": "Rumor",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "world_instance_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "definition_id": {
      "type": "string"
    },
    "definition_key": {
      "type": "string"
    },
    "proposition_key": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "origin_ref": {
      "type": "object",
      "additionalProperties": true
    },
    "current_holder_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "accuracy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "strength": {
      "type": "number",
      "minimum": 0
    },
    "spread_count": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "next_spread_minute": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "dormant",
        "resolved"
      ],
      "default": "active"
    },
    "source_event_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "world_instance_id",
    "content_version",
    "proposition_key",
    "payload",
    "accuracy",
    "strength",
    "spread_count",
    "next_spread_minute",
    "status",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}