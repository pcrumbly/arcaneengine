{
  "name": "AchievementProgress",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "character_id": {
      "type": "string"
    },
    "achievement_definition_id": {
      "type": "string"
    },
    "progress_key": {
      "type": "string"
    },
    "criteria_values": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "percent": {
      "type": "number",
      "default": 0
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reward_state": {
      "type": "string",
      "enum": [
        "pending",
        "granting",
        "granted"
      ],
      "default": "pending"
    },
    "reward_transaction_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "content_version",
    "character_id",
    "achievement_definition_id",
    "criteria_values",
    "percent",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}