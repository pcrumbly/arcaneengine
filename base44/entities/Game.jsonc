{
  "name": "Game",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "terminology": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "enabled_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "visible": {
            "type": "boolean"
          }
        },
        "required": [
          "route",
          "label"
        ]
      }
    },
    "header_indicators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "character_defaults": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "currency": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "primary_resource_key": {
          "type": "string"
        },
        "defense_attribute_key": {
          "type": "string"
        },
        "inventory_capacity": {
          "type": "number"
        },
        "starter_stack_quantity": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "key",
    "title",
    "status"
  ]
}