{
  "name": "Game",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "terminology": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "muted": {
          "type": "string"
        },
        "border": {
          "type": "string"
        },
        "danger": {
          "type": "string"
        },
        "heading_font": {
          "type": "string",
          "enum": [
            "system",
            "serif",
            "mono"
          ]
        },
        "body_font": {
          "type": "string",
          "enum": [
            "system",
            "serif",
            "mono"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "compact",
            "comfortable",
            "spacious"
          ]
        },
        "radius": {
          "type": "string",
          "enum": [
            "sharp",
            "rounded",
            "pill"
          ]
        },
        "media_style": {
          "type": "string",
          "enum": [
            "square",
            "rounded",
            "cinematic"
          ]
        }
      }
    },
    "enabled_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "label_key": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "visible": {
            "type": "boolean"
          }
        },
        "required": [
          "route",
          "label"
        ]
      }
    },
    "header_indicators": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "character",
                  "location",
                  "resource",
                  "currency",
                  "attribute",
                  "text"
                ]
              },
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "label_key": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "value_key": {
                "type": "string"
              },
              "aggregate": {
                "type": "string",
                "enum": [
                  "first",
                  "sum"
                ]
              }
            },
            "required": [
              "type"
            ]
          }
        ]
      }
    },
    "character_defaults": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "currency": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "calendar": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "minutes_per_hour": {
          "type": "number",
          "minimum": 1
        },
        "hours_per_day": {
          "type": "number",
          "minimum": 1
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "name"
            ]
          }
        },
        "months": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "days": {
                "type": "number",
                "minimum": 1
              }
            },
            "required": [
              "key",
              "name",
              "days"
            ]
          }
        },
        "epoch": {
          "type": "object",
          "properties": {
            "year": {
              "type": "number"
            },
            "month": {
              "type": "number",
              "minimum": 1
            },
            "day": {
              "type": "number",
              "minimum": 1
            },
            "hour": {
              "type": "number",
              "minimum": 0
            },
            "minute": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "format": {
          "type": "string"
        }
      }
    },
    "simulation": {
      "type": "object",
      "properties": {
        "local_tick_minutes": {
          "type": "number",
          "minimum": 1
        },
        "regional_tick_minutes": {
          "type": "number",
          "minimum": 1
        },
        "global_tick_minutes": {
          "type": "number",
          "minimum": 1
        },
        "max_fast_forward_minutes": {
          "type": "number",
          "minimum": 1
        },
        "fast_forward_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "minutes": {
                "type": "number",
                "minimum": 1
              },
              "rest": {
                "type": "boolean"
              }
            },
            "required": [
              "label",
              "minutes"
            ]
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "primary_resource_key": {
          "type": "string"
        },
        "defense_attribute_key": {
          "type": "string"
        },
        "inventory_capacity": {
          "type": "number"
        },
        "starter_stack_quantity": {
          "type": "number"
        },
        "world_start_time": {
          "type": "string",
          "format": "date-time"
        },
        "weather_interval_minutes": {
          "type": "number",
          "minimum": 1
        }
      }
    }
  },
  "required": [
    "key",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}