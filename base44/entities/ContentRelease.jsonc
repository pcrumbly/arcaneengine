{
  "name": "ContentRelease",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "content_pack_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "editing",
        "indexing",
        "validating",
        "publishing",
        "published",
        "retired"
      ],
      "default": "draft"
    },
    "revision": {
      "type": "number",
      "minimum": 1,
      "default": 1
    },
    "validation_revision": {
      "type": "number",
      "minimum": 1
    },
    "dependency_index_revision": {
      "type": "number",
      "minimum": 1
    },
    "snapshot_revision": {
      "type": "number",
      "minimum": 1
    },
    "snapshot_record_count": {
      "type": "number",
      "minimum": 0
    },
    "snapshot_hash": {
      "type": "string"
    },
    "snapshot_compiled_at": {
      "type": "string",
      "format": "date-time"
    },
    "lock_token": {
      "type": "string"
    },
    "lock_acquired_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "game_id",
    "version",
    "status",
    "revision"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}