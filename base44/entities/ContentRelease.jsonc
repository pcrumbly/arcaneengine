{
  "name": "ContentRelease",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "content_pack_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validating",
        "published",
        "retired"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "game_id",
    "version",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}