{
  "name": "CrimeDefinition",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "jurisdiction_key": {
      "type": "string"
    },
    "severity": {
      "type": "number",
      "minimum": 0
    },
    "standing_delta": {
      "type": "number"
    },
    "report_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "expires_after_minutes": {
      "type": "number",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "game_id",
    "content_version",
    "key",
    "name",
    "jurisdiction_key",
    "severity"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}