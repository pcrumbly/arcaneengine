{
  "name": "CombatParticipant",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "combat_instance_id": {
      "type": "string"
    },
    "character_id": {
      "type": "string"
    },
    "source_definition_id": {
      "type": "string"
    },
    "team": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "maximum_resources": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "ability_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cooldowns": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "ai_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "incapacitated",
        "escaped"
      ]
    },
    "initiative": {
      "type": "number"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "combat_instance_id",
    "team",
    "name",
    "resources",
    "status",
    "initiative"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}