{
  "name": "CommandUsage",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "window_key": {
      "type": "string"
    },
    "count": {
      "type": "number",
      "default": 1
    },
    "limit": {
      "type": "number"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "user_id",
    "command",
    "window_key",
    "count",
    "limit"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}