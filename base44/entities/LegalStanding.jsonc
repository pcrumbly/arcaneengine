{
  "name": "LegalStanding",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "world_instance_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "character_id": {
      "type": "string"
    },
    "jurisdiction_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "clear",
        "suspected",
        "wanted",
        "convicted",
        "pardoned"
      ],
      "default": "clear"
    },
    "severity": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "bounty": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "open_incident_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_changed_minute": {
      "type": "number",
      "minimum": 0
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "world_instance_id",
    "content_version",
    "character_id",
    "jurisdiction_key",
    "status",
    "severity",
    "bounty",
    "open_incident_ids",
    "last_changed_minute",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}