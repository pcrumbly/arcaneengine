{
  "name": "WitnessReport",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "world_instance_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "incident_id": {
      "type": "string"
    },
    "witness_ref": {
      "type": "object",
      "additionalProperties": true
    },
    "reliability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "statement": {
      "type": "object",
      "additionalProperties": true
    },
    "reported_to_faction_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "observed",
        "reported",
        "dismissed"
      ],
      "default": "observed"
    },
    "observed_minute": {
      "type": "number",
      "minimum": 0
    },
    "reported_minute": {
      "type": "number",
      "minimum": 0
    },
    "source_event_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "world_instance_id",
    "content_version",
    "incident_id",
    "witness_ref",
    "reliability",
    "statement",
    "status",
    "observed_minute",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}