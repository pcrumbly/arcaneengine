{
  "name": "UserSetting",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "account",
        "player",
        "game",
        "sound",
        "accessibility"
      ]
    },
    "values": {
      "type": "object",
      "additionalProperties": true
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "user_id",
    "scope",
    "values"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}