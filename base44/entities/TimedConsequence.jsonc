{
  "name": "TimedConsequence",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "world_instance_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "character_id": {
      "type": "string"
    },
    "consequence_key": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string"
    },
    "due_minute": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "processing",
        "completed",
        "cancelled",
        "failed"
      ],
      "default": "scheduled"
    },
    "conditions": {
      "type": "object",
      "additionalProperties": true
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "emitted_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "string"
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": true
    },
    "source_event_id": {
      "type": "string"
    },
    "result": {
      "type": "object",
      "additionalProperties": true
    },
    "processed_minute": {
      "type": "number",
      "minimum": 0
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "world_instance_id",
    "content_version",
    "character_id",
    "consequence_key",
    "dedupe_key",
    "due_minute",
    "status",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}