{
  "name": "DomainEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "number",
      "default": 1
    },
    "event_type": {
      "type": "string"
    },
    "game_id": {
      "type": "string"
    },
    "world_instance_id": {
      "type": "string"
    },
    "character_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "aggregate_type": {
      "type": "string"
    },
    "aggregate_id": {
      "type": "string"
    },
    "aggregate_ref": {
      "type": "object",
      "additionalProperties": true
    },
    "subject_ref": {
      "type": "object",
      "additionalProperties": true
    },
    "actor_ref": {
      "type": "object",
      "additionalProperties": true
    },
    "request_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "sequence": {
      "type": "number"
    },
    "producer": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_id",
    "schema_version",
    "game_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "aggregate_ref",
    "request_id",
    "correlation_id",
    "sequence",
    "producer",
    "occurred_at",
    "recorded_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}