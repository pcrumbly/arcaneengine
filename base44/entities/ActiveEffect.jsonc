{
  "name": "ActiveEffect",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "character",
        "combat_participant"
      ]
    },
    "target_id": {
      "type": "string"
    },
    "combat_instance_id": {
      "type": "string"
    },
    "status_key": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "stacks": {
      "type": "number",
      "default": 1
    },
    "remaining_turns": {
      "type": "number"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "content_version",
    "target_type",
    "target_id",
    "status_key",
    "stacks"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}