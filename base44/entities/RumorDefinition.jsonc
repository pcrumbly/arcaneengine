{
  "name": "RumorDefinition",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "proposition_key": {
      "type": "string"
    },
    "seed_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "base_accuracy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "base_strength": {
      "type": "number",
      "minimum": 0
    },
    "spread_interval_minutes": {
      "type": "number",
      "minimum": 1
    },
    "decay_per_spread": {
      "type": "number",
      "minimum": 0
    },
    "max_spreads": {
      "type": "number",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "game_id",
    "content_version",
    "key",
    "name",
    "proposition_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}