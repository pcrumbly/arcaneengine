{
  "name": "SocialProcessingReceipt",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "world_instance_id": {
      "type": "string"
    },
    "source_event_id": {
      "type": "string"
    },
    "processor_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "completed",
        "failed"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": true
    },
    "error": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "source_event_id",
    "processor_key",
    "status",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}