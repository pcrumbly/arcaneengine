{
  "name": "WeatherDefinition",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "region_key": {
      "type": "string",
      "default": "default"
    },
    "description": {
      "type": "string"
    },
    "temperature": {
      "type": "number"
    },
    "weight": {
      "type": "number",
      "minimum": 1,
      "default": 1
    },
    "active_month_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_phases": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "night",
          "morning",
          "afternoon",
          "evening"
        ]
      }
    },
    "transition_weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "game_id",
    "content_version",
    "key",
    "name",
    "region_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}