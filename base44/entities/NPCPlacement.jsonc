{
  "name": "NPCPlacement",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "npc_instance_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "visibility_conditions": {
      "type": "object",
      "additionalProperties": true
    },
    "interaction_conditions": {
      "type": "object",
      "additionalProperties": true
    },
    "schedule": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "game_id",
    "content_version",
    "npc_instance_id",
    "location_id",
    "enabled"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}