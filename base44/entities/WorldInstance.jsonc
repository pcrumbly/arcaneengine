{
  "name": "WorldInstance",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "definition_ref": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived"
      ],
      "default": "active"
    },
    "epoch_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_minute": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "current_time": {
      "type": "string",
      "format": "date-time"
    },
    "seed": {
      "type": "number"
    },
    "rng_cursor": {
      "type": "number",
      "default": 0
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "game_id",
    "content_version",
    "key",
    "definition_ref",
    "status",
    "epoch_at",
    "current_minute",
    "current_time",
    "seed",
    "rng_cursor",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}