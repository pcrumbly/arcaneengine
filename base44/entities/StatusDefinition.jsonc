{
  "name": "StatusDefinition",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string"
    },
    "content_version": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "stacking": {
      "type": "string",
      "enum": [
        "replace",
        "stack",
        "refresh"
      ]
    },
    "maximum_stacks": {
      "type": "number",
      "default": 1
    },
    "duration_type": {
      "type": "string",
      "enum": [
        "turns",
        "time",
        "permanent"
      ]
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "game_id",
    "content_version",
    "key",
    "name",
    "stacking",
    "duration_type"
  ]
}